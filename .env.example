# Venice Mesh Environment Variables 
 
 # Database 
 DB_HOST=postgres 
 DB_PORT=5432 
 DB_NAME=venice_mesh 
 DB_USER=venice 
 DB_PASSWORD=change_this_secure_password 
 
 # Redis 
 REDIS_PASSWORD=change_this_redis_password 
 
 # API 
 PORT=3000 
 JWT_SECRET=change_this_jwt_secret_at_least_32_characters 
 
 # Optional: Supabase (if using as backup) 
 NEXT_PUBLIC_SUPABASE_URL= 
 NEXT_PUBLIC_SUPABASE_ANON_KEY= 
 SUPABASE_SERVICE_ROLE_KEY= 
 
 # Email (for notifications) 
 SMTP_HOST= 
 SMTP_PORT=587 
 SMTP_USER= 
 SMTP_PASS=